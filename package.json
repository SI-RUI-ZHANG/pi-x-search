{
  "name": "pi-x-search",
  "version": "0.1.0",
  "description": "Search X from the pi coding agent with verbatim post quotes and resolved source URLs.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "check:release": "node ./scripts/check-release.mjs",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "verify": "npm run check && npm test",
    "prepublishOnly": "npm run verify && npm run check:release"
  },
  "author": "Sirui Zhang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SI-RUI-ZHANG/pi-x-search.git"
  },
  "homepage": "https://github.com/SI-RUI-ZHANG/pi-x-search#readme",
  "bugs": {
    "url": "https://github.com/SI-RUI-ZHANG/pi-x-search/issues"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "x",
    "twitter",
    "search",
    "grok",
    "xai"
  ],
  "files": [
    "extensions",
    "src",
    "docs/design.md",
    "docs/assets",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "image": "https://raw.githubusercontent.com/SI-RUI-ZHANG/pi-x-search/main/docs/assets/hero.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@types/node": "26.1.2",
    "typebox": "1.1.38",
    "typescript": "7.0.2"
  }
}
